<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Sólo HTTPS. No se confía en certificados de usuario para evitar interceptación. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
